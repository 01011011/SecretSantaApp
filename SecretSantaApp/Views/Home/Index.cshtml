<div x-data="secretSanta">
    <h3>Create your Secret Santa now - Start by adding people</h3>

    <form x-on:submit.prevent>
        <table class="table">
            <tr class="row">
                <td style="width: 33.33%">
                    <input class="input-add" placeholder="Add Name (Must be unique)"
                           x-model="userToAdd" x-on:keydown.enter="addUser()" />
                    <button class="btn btn-primary" x-on:click="addUser()" x-bind:disabled="!userToAdd.length">Add</button>
                </td>
                <td style="width: 33.33%">
                    <div x-show="enableGroupAdd">
                        <button class="btn btn-primary" x-on:click="showGroupNameInput = true">Create Group</button>
                        <div x-show="showGroupNameInput">
                            <span>Enter Group Name: </span>
                            <input class="form-control form-control-sm d-inline-block w-auto" x-model="groupName"
                                   x-on:keydown.enter="saveGroup()" />
                            <button class="btn btn-primary" x-on:click="saveGroup()">Save</button>
                        </div>
                    </div>
                    <div x-show="showBoth">
                        <p>- OR -</p>
                    </div>
                    <div x-show="canAddToGroup">
                        Add to an existing Group:
                        <select class="form-select" x-model="selectedGroupId">
                            <option value="">Choose...</option>
                            <template x-for="g in groups" x-bind:key="g.Id">
                                <option x-bind:value="g.Id" x-text="g.Name"></option>
                            </template>
                        </select><br />
                        <button class="btn btn-primary" x-on:click="updateGroup()">Update</button>
                    </div>
                </td>
                <td style="width: 33.33%">
                    <button class="btn btn-primary" x-on:click="runMatch()">Match</button>
                </td>
            </tr>
            <tr class="row">
                <td style="width: 33%" x-show="usersVisible">
                    <h3>Users</h3>
                    <table class="table">
                        <thead class="table-dark">
                            <tr>
                                <th>Select</th>
                                <th>Name</th>
                                <th>Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            <template x-for="user in users" x-bind:key="user.Id">
                                <tr>
                                    <td>
                                        <template x-if="!isUserInGroup(user.Id)">
                                            <input type="checkbox" x-show="checkVisible"
                                                   x-bind:checked="isUserSelected(user.Id)"
                                                   x-on:click="toggleUserSelection(user)" />
                                        </template>
                                        <template x-if="isUserInGroup(user.Id)">
                                            <i class="fas fa-check"></i>
                                        </template>
                                    </td>
                                    <td x-text="user.Name"></td>
                                    <td><button class="btn btn-danger" x-on:click="deleteUser(user)">Delete</button></td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </td>
                <td style="width: 33.33%" x-show="groupsVisible">
                    <h3>Groups</h3>
                    <template x-for="group in groups" x-bind:key="group.Id">
                        <table class="table">
                            <thead class="table-dark">
                                <tr>
                                    <th colspan="2" x-text="group.Name"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <template x-for="u in group.Users" x-bind:key="u.Id">
                                    <tr>
                                        <td x-text="u.Name"></td>
                                        <td><button class="btn btn-danger" x-on:click="removeFromGroup(group.Id, u)">Remove</button></td>
                                    </tr>
                                </template>
                            </tbody>
                        </table>
                    </template>
                </td>
                <td style="width: 33.33%" x-show="showMatching">
                    <h3>Matches</h3>
                    <table class="table">
                        <thead class="table-dark">
                            <tr>
                                <th>Sender</th>
                                <th>&rarr;</th>
                                <th>Receiver</th>
                            </tr>
                        </thead>
                        <tbody>
                            <template x-for="m in matches" x-bind:key="m.Sender">
                                <tr>
                                    <td x-text="m.Sender"></td>
                                    <td>&rarr;</td>
                                    <td x-text="m.Receiver"></td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </td>
            </tr>
        </table>
    </form>
</div>